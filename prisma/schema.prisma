generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id              String   @id @default(cuid())

  // wizard selections (stable codes, not display labels)
  date            String
  program         String
  timeSlot        String
  groupSize       String
  equipment       String
  level           String
  ageGroup        String
  liftPassPayment String
  requestNote     String?
  locale          String

  // contact
  name            String
  phone           String

  // pricing snapshot at time of booking (site.ts rates may change later)
  basePrice       Int
  liftPassFee     Int
  totalPrice      Int
  priceOnRequest  Boolean  @default(false)

  // pre-rendered customer-facing summary text (what they copy to KakaoTalk)
  message         String

  status          String   @default("requested") // requested | confirming | confirmed | cancelled
  paymentStatus   String   @default("unpaid")
  memo            String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([date])
}
